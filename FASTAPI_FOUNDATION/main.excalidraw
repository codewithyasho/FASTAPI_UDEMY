      "isDeleted": false,
      "boundElements": [],
      "updated": 1774695229303,
      "link": null,
      "locked": false,
      "text": "Chai Point, Bengaluru wants a read-only menu API so\ntheir kiosk displays and mobile apps can fetch the latest\nmenu without hitting a database.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chai Point, Bengaluru wants a read-only menu API so their kiosk displays and mobile apps can fetch the latest menu without hitting a database.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "gXZXnw-ciq3B0hPCrEzsr",
      "type": "rectangle",
