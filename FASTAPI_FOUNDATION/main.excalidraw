      "versionNonce": 362195008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774778057236,
      "link": null,
      "locked": false,
      "text": "A D2C brand needs to auto-fill city and state fields\nwhen a customer types their pincode during checkout.\nThis reduces friction and typos in the address form.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A D2C brand needs to auto-fill city and state fields when a customer types their pincode during checkout. This reduces friction and typos in the address form.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
