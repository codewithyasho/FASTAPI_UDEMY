      "updated": 1772828717526,
      "link": null,
      "locked": false,
      "text": "`async def` runs on the main event loop",
      "fontSize": 43.239109450225804,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "`async def` runs on the main event loop",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "n_Dc1M-oU2ihh3m2ujwEz",
      "type": "text",
      "x": 234.1147693526625,
      "y": 7831.378997941186,
      "width": 1040.9969354029006,
      "height": 105.21501601139155,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 298952236,
      "version": 100,
      "versionNonce": 990840108,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772828736808,
      "link": null,
      "locked": false,
      "text": "`def` runs in a thread pool (FastAPI handles this\nautomatically!)",
      "fontSize": 42.08600640455662,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "`def` runs in a thread pool (FastAPI handles this automatically!)",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "UAEoMwuBlaJwCSOa5DX9o",
      "type": "text",
      "x": 208.50247774400225,
      "y": 7995.685842393632,
      "width": 969.6013343162803,
      "height": 48.18327792340824,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1K",
      "roundness": null,
      "seed": 1675143724,
      "version": 63,
      "versionNonce": 986585364,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772828877774,
      "link": null,
      "locked": false,
      "text": "If you use `async def` but call sync code inside it,",
      "fontSize": 38.54662233872659,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If you use `async def` but call sync code inside it,",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "HjY54mWKJzots_8IRJSdI",
      "type": "text",
      "x": 215.99428231799538,
      "y": 8070.9527094329405,
      "width": 913.747332995645,
      "height": 96.36655584681648,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1L",
      "roundness": null,
      "seed": 1660903060,
      "version": 131,
      "versionNonce": 1527615508,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772828881478,
      "link": null,
      "locked": false,
      "text": "you BLOCK the entire event loop = terrible\nperformance",
      "fontSize": 38.54662233872659,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "you BLOCK the entire event loop = terrible performance",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
