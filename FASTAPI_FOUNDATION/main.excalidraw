      "versionNonce": 1640157248,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774787803111,
      "link": null,
      "locked": false,
      "text": "Rangmanch, a Pune-based theatre booking startup, needs a reviews\nAPI so audiences can rate and review plays. The API powers their\napp's review section and average rating displays.",
      "fontSize": 34.04935524749735,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "2KwyNb7sdOVDzZF6WGbZx",
      "originalText": "Rangmanch, a Pune-based theatre booking startup, needs a reviews API so audiences can rate and review plays. The API powers their app's review section and average rating displays.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
