      "isDeleted": false,
      "boundElements": [],
      "updated": 1781149998858,
      "link": null,
      "locked": false,
      "text": "IIT Bombay fest needs a live polling system where audience members\nvote from their phones and see results update in real-time on the big\nscreen. No page refresh — votes appear instantly via WebSocket.",
      "fontSize": 34.04935524749735,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "pay5ZDybu6SuKKWLMQ3DR",
      "originalText": "IIT Bombay fest needs a live polling system where audience members vote from their phones and see results update in real-time on the big screen. No page refresh — votes appear instantly via WebSocket.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
